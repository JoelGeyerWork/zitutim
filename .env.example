# Local MongoDB from docker-compose.yml
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=zitutim

# --- Sessions ---
# Signs the session cookie. 32+ characters. Generate one with:
#   openssl rand -base64 32
SESSION_SECRET=
# How long a login stays valid. Default 8 — a workday.
SESSION_TTL_HOURS=8

# --- Active Directory ---
# ldaps:// is required: a simple bind sends the password in cleartext, so plain
# ldap:// leaks every employee's Windows password to anyone on the wire. To use
# ldap:// with an explicit StartTLS upgrade instead, set LDAP_STARTTLS=true.
LDAP_URL=ldaps://dc01.example.local:636
LDAP_STARTTLS=false
# Where to search for user accounts.
LDAP_BASE_DN=OU=Users,DC=example,DC=local
# A dedicated read-only service account — NOT a Domain Admin. It only needs to
# read user objects. Note that its own password expiring silently breaks login
# for everyone, so give it "password never expires" or monitor it.
LDAP_BIND_DN=CN=svc-zitutim,OU=Service Accounts,DC=example,DC=local
LDAP_BIND_PASSWORD=
# Path to the enterprise root CA in PEM form, if the DC's certificate isn't
# publicly trusted. NODE_EXTRA_CA_CERTS works too.
LDAP_TLS_CA=
# Skips verification of the DC's certificate. The connection stays encrypted —
# what this gives up is proving you're talking to the real DC, which allows an
# active MITM to harvest domain passwords. Accepted here because the network is
# air-gapped. On any routable network, set LDAP_TLS_CA instead.
LDAP_TLS_INSECURE=false

# How this directory spells identity. The defaults below are Active Directory's;
# they only need changing to run against something else (an OpenLDAP container
# for local testing, say, which would want:
#   LDAP_USER_FILTER=(objectClass=inetOrgPerson)
#   LDAP_LOGIN_ATTRS=uid,mail
#   LDAP_ID_ATTR=entryUUID
# ). LDAP_ID_ATTR must name something *immutable* — everything a user adds hangs
# off it, and directories reissue usernames. Only objectGUID is read as binary.
LDAP_USER_FILTER=(&(objectCategory=person)(objectClass=user))
LDAP_LOGIN_ATTRS=sAMAccountName,userPrincipalName
LDAP_ID_ATTR=objectGUID

# How the roster editor's directory search turns what you typed into a filter.
# This is the setting that decides whether that search feels instant or times
# out, so change it only knowingly:
#   anr       — Active Directory's Ambiguous Name Resolution. One indexed clause
#               the DC expands over givenName, sn, displayName, sAMAccountName
#               and more, each matched as a prefix. What Outlook's address book
#               uses, and the right answer on any AD.
#   prefix    — "typed*" against displayName and LDAP_LOGIN_ATTRS. For a non-AD
#               directory that has no anr but does index those attributes.
#   substring — "*typed*" against the same attributes. Matches the most, and is
#               the slowest by a wide margin: a leading wildcard cannot use an
#               index, so the server reads every user object under LDAP_BASE_DN
#               on every keystroke. Only worth it on a small directory, or one
#               that can answer nothing else.
LDAP_SEARCH_MODE=anr

# How long the directory gets to answer a single search, in whole seconds. Sent
# as the LDAP timeLimit, and the socket timeout is set five seconds above it so
# a server that does answer "took too long" is reported as a timeout rather than
# as an outage. Exceeding it is not a slow result, it is no result: the search
# fails and the editor says so. Raising this is the wrong fix for a slow search
# — LDAP_SEARCH_MODE is the right one.
LDAP_TIMEOUT_SECONDS=30

# Set to true ONLY when the app sits behind a proxy that overwrites
# X-Forwarded-For. Otherwise the header is client-controlled and the per-IP
# login throttle becomes trivially bypassable.
LOGIN_TRUSTED_PROXY=false

# --- Outgoing mail ---
# The internal SMTP relay that sends a quote to the team. Sharing is the only
# thing that breaks without these; everything else works unconfigured.
SMTP_HOST=
# 25 and 587 upgrade with STARTTLS when the relay offers it; 465 is implicit
# TLS and needs SMTP_SECURE=true.
SMTP_PORT=25
SMTP_SECURE=false
# Leave both unset for a relay that accepts unauthenticated internal mail.
# Setting only one is rejected rather than half-applied — SMTP authentication
# always carries a username, so an API key goes in SMTP_PASSWORD and still needs
# a SMTP_USER to send it under. Providers usually specify a fixed one to use
# (SendGrid wants the literal "apikey"); an internal relay is likelier to want
# the account name.
SMTP_USER=
SMTP_PASSWORD=
# Skips verification of the relay's certificate. The connection stays encrypted
# — what this gives up is proving you're talking to the real relay, which allows
# an active MITM to harvest whatever SMTP_PASSWORD holds. Accepted here because
# the network is air-gapped, the same trade as LDAP_TLS_INSECURE. On anything
# routable, point NODE_EXTRA_CA_CERTS at the issuing CA instead.
SMTP_TLS_INSECURE=false

# The envelope sender, and the team list every quote is sent to.
MAIL_FROM=zitutim@example.local
MAIL_TO=team@example.local
# Builds and logs the message without handing it to the relay. Worth setting
# for the first send against production, where MAIL_TO is a whole team.
MAIL_DRY_RUN=false
