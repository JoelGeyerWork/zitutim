# Local MongoDB from docker-compose.yml
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=zitutim

# --- Sessions ---
# Signs the session cookie. 32+ characters. Generate one with:
#   openssl rand -base64 32
SESSION_SECRET=
# How long a login stays valid. Default 8 — a workday.
SESSION_TTL_HOURS=8

# --- Active Directory ---
# ldaps:// is required: a simple bind sends the password in cleartext, so plain
# ldap:// leaks every employee's Windows password to anyone on the wire. To use
# ldap:// with an explicit StartTLS upgrade instead, set LDAP_STARTTLS=true.
LDAP_URL=ldaps://dc01.example.local:636
LDAP_STARTTLS=false
# Where to search for user accounts.
LDAP_BASE_DN=OU=Users,DC=example,DC=local
# A dedicated read-only service account — NOT a Domain Admin. It only needs to
# read user objects. Note that its own password expiring silently breaks login
# for everyone, so give it "password never expires" or monitor it.
LDAP_BIND_DN=CN=svc-zitutim,OU=Service Accounts,DC=example,DC=local
LDAP_BIND_PASSWORD=
# Path to the enterprise root CA in PEM form, if the DC's certificate isn't
# publicly trusted. NODE_EXTRA_CA_CERTS works too.
LDAP_TLS_CA=
# Skips verification of the DC's certificate. The connection stays encrypted —
# what this gives up is proving you're talking to the real DC, which allows an
# active MITM to harvest domain passwords. Accepted here because the network is
# air-gapped. On any routable network, set LDAP_TLS_CA instead.
LDAP_TLS_INSECURE=false

# How this directory spells identity. The defaults below are Active Directory's;
# they only need changing to run against something else (an OpenLDAP container
# for local testing, say, which would want:
#   LDAP_USER_FILTER=(objectClass=inetOrgPerson)
#   LDAP_LOGIN_ATTRS=uid,mail
#   LDAP_ID_ATTR=entryUUID
# ). LDAP_ID_ATTR must name something *immutable* — everything a user adds hangs
# off it, and directories reissue usernames. Only objectGUID is read as binary.
LDAP_USER_FILTER=(&(objectCategory=person)(objectClass=user))
LDAP_LOGIN_ATTRS=sAMAccountName,userPrincipalName
LDAP_ID_ATTR=objectGUID

# Set to true ONLY when the app sits behind a proxy that overwrites
# X-Forwarded-For. Otherwise the header is client-controlled and the per-IP
# login throttle becomes trivially bypassable.
LOGIN_TRUSTED_PROXY=false
