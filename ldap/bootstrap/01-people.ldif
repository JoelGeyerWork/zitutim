# Seed users for the local OpenLDAP container. Loaded once, when the directory
# is first initialised — `npm run ldap:down` drops the volume, so changes here
# take effect on the next `ldap:up`.
#
# This is a plain LDAP directory, not Active Directory: identity is spelled
# uid / entryUUID rather than sAMAccountName / objectGUID. entryUUID is
# generated by slapd, so it is not set here.

dn: ou=people,dc=test,dc=local
objectClass: organizationalUnit
ou: people

# Mixed case on purpose: the app lowercases the username it stores, and the
# directory matches case-insensitively.
dn: uid=dana,ou=people,dc=test,dc=local
objectClass: inetOrgPerson
uid: Dana
cn: Dana Cohen
sn: Cohen
displayName: דנה כהן
mail: Dana@Test.Local
userPassword: correct-horse

dn: uid=omer,ou=people,dc=test,dc=local
objectClass: inetOrgPerson
uid: omer
cn: Omer Levi
sn: Levi
displayName: עומר לוי
mail: omer@test.local
userPassword: another-password

# No displayName, to exercise the fallback to cn.
dn: uid=noa,ou=people,dc=test,dc=local
objectClass: inetOrgPerson
uid: noa
cn: Noa Bar
sn: Bar
userPassword: third-password
