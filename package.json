{
  "name": "zitutim",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run --project server --project ui",
    "test:watch": "vitest --project server --project ui",
    "test:ui": "vitest run --project ui",
    "test:server": "vitest run --project server",
    "test:ldap": "vitest run --project ldap",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "app:up": "docker compose --profile app up -d --build",
    "app:down": "docker compose --profile app down",
    "db:seed": "node --env-file=.env.local scripts/seed.mjs",
    "db:seed:demo": "node --env-file=.env.local scripts/seed.mjs --demo",
    "ldap:certs": "node scripts/ldap-certs.mjs",
    "ldap:up": "npm run ldap:certs && docker compose -f docker-compose.ldap.yml up -d --wait",
    "ldap:down": "docker compose -f docker-compose.ldap.yml down -v"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jose": "^6.2.8",
    "ldapts": "^9.0.0",
    "lucide-react": "^1.30.0",
    "mongodb": "^7.5.0",
    "next": "16.3.0",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "shadcn": "^4.16.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "jsdom": "^30.0.1",
    "mongodb-memory-server": "^11.2.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
